{
  "name": "suivi-conformite-server",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "API du suivi de conformité ISO 27001 / NIS2 (Fastify + PostgreSQL)",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "node build.mjs",
