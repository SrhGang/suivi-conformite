# Caddy : certificat HTTPS automatique pour {$DOMAIN}, fichiers statiques du
# frontend et proxy vers l'API.
#  - domaine public : certificat Let's Encrypt (ports 80/443 joignables) ;
#  - nom MagicDNS en *.ts.net : certificat délivré par Tailscale via le socket
#    tailscaled (voir ops/compose.tailscale.yml).
#  - nom interne (lab, intranet) absent du DNS public : CADDY_TLS dans .env,
#    sinon Caddy tente Let's Encrypt et échoue (NXDOMAIN). Voir ops/compose.tls-fichiers.yml.
# Caddy est le point d'entrée : il transmet lui-même l'adresse du client à
# l'API (TRUST_PROXY = 1 saut).
#
# Ce fichier est monté dans le conteneur (docker-compose.yml) : après une
# modification, « docker compose up -d --force-recreate web » suffit, sans rebuild.

{$DOMAIN} {
	# Vide par défaut (certificat automatique). Exemples :
	#   CADDY_TLS=tls internal   (autorité de certification interne de Caddy)
	#   CADDY_TLS=tls /etc/caddy/certs/fullchain.pem /etc/caddy/certs/privkey.pem
	{$CADDY_TLS}

	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=63072000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "no-referrer"
		Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
		Cross-Origin-Opener-Policy "same-origin"
		Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self'; frame-src 'none'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"
		-Server
	}

	handle /api/* {
		reverse_proxy api:3000
	}

	handle {
		root * /srv/www
		@assets path /assets/*
		header @assets Cache-Control "public, max-age=31536000, immutable"
		# Application monopage : toutes les routes renvoient index.html.
		try_files {path} /index.html
		file_server
	}

	log {
		output stdout
		format json
	}
}
