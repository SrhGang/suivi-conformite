# Copier en .env puis renseigner. Ne jamais commiter le fichier .env.
# Les secrets ne sont PAS ici : voir ops/secrets.sh.

# Nom d'accès à l'application :
#  - domaine public (enregistrement DNS A/AAAA vers la VM, ports 80/443 ouverts) : conformite.example.fr
#  - ou nom MagicDNS Tailscale : vm-conformite.nom-du-tailnet.ts.net (voir COMPOSE_FILE ci-dessous)
DOMAIN=conformite.example.fr

# Organisme affiché dans l'application.
ORG_NAME=Mon organisme
ORG_SECTOR=Entité essentielle NIS2

# Accès via Tailscale uniquement : décommenter les deux lignes et mettre l'IP Tailscale de la VM
# (commande : tailscale ip -4).
#COMPOSE_FILE=docker-compose.yml:ops/compose.tailscale.yml
#BIND_ADDRESS=100.x.y.z

# Secrets chiffrés par systemd-creds (sudo ops/secrets.sh systemd-creds) : décommenter.
#SECRETS_DIR=/run/conformite

# Facultatif
TOTP_ISSUER=Conformité ISO 27001
MAX_UPLOAD_MB=20
