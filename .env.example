# Copier en .env puis renseigner. Ne jamais commiter le fichier .env.

# Nom de domaine pointant vers la VM (enregistrement DNS A/AAAA) et e-mail Let's Encrypt.
DOMAIN=conformite.example.fr
ACME_EMAIL=rssi@example.fr

# Organisme affiché dans l'application.
ORG_NAME=Mon organisme
ORG_SECTOR=Entité essentielle NIS2

# Secrets : générer chacun avec   openssl rand -base64 48
OWNER_DB_PASSWORD=
APP_DB_PASSWORD=
APP_SECRET=

# Facultatif
TOTP_ISSUER=Conformité ISO 27001
MAX_UPLOAD_MB=20
